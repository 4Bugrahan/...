{
  "version": 2,
  "framework": null,
  "regions": ["fra1"],
  "buildCommand": "echo 'Skipping frontend build'",
  "installCommand": "echo 'Skipping npm install'",
  "functions": {
    "api/index.php": {
      "runtime": "vercel-php@0.7.1"
    }
  },
  "routes": [
    {
      "src": "/build/(.*)",
      "dest": "/public/build/$1"
    },
    {
       "src": "/assets/(.*)",
       "dest": "/public/assets/$1"
    },
    {
      "src": "/storage/(.*)",
      "dest": "/public/storage/$1"
    },
    {
      "src": "/files/(.*)",
      "dest": "/public/files/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/videos/(.*)",
      "dest": "/public/videos/$1"
    },
    {
      "src": "/favicon\\.(ico|png)",
      "dest": "/public/favicon.$1"
    },
    {
      "src": "/apple-touch-icon(-precomposed)?\\.png",
      "dest": "/public/apple-touch-icon.png"
    },
    {
      "src": "/robots\\.txt",
      "dest": "/public/robots.txt"
    },
    {
      "src": "/(.*)",
      "dest": "/api/index.php"
    }
  ],
  "env": {
    "APP_URL": "https://4bgrup.vercel.app",
    "APP_ENV": "production",
    "APP_DEBUG": "false",
    "APP_KEY": "base64:fDtrYFxeJ5UJ0IP5ankwSUO+7IJi4vQgMytk7LdGCG0=",
    "CACHE_STORE": "database",
    "CACHE_DRIVER": "database",
    "SESSION_DRIVER": "cookie",
    "QUEUE_CONNECTION": "sync",
    "DB_CONNECTION": "pgsql",
    "DB_HOST": "aws-0-eu-central-1.pooler.supabase.com",
    "DB_PORT": "6543",
    "DB_DATABASE": "postgres",
    "DB_USERNAME": "postgres.oaruhqbjuqgcnocxiopt",
    "DB_SSLMODE": "require",
    "PUBLIC_DISK": "s3",
    "AWS_DEFAULT_REGION": "eu-central-1",
    "AWS_BUCKET": "4bgrup-media",
    "AWS_URL": "https://oaruhqbjuqgcnocxiopt.supabase.co/storage/v1/object/public/4bgrup-media",
    "AWS_ENDPOINT": "https://oaruhqbjuqgcnocxiopt.storage.supabase.co/storage/v1/s3",
    "AWS_USE_PATH_STYLE_ENDPOINT": "true"
  }
}
